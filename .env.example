# Northstar Banking - Microservices Environment Variables Configuration Template

# Database Configurations
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root

# Microservice Specific Datasource URLs (defaults provided in application.yml)
# AUTH_DB_URL=jdbc:mysql://localhost:3306/authdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# CUSTOMER_DB_URL=jdbc:mysql://localhost:3306/customerdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# ACCOUNT_DB_URL=jdbc:mysql://localhost:3306/accountdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Service Registry (Eureka)
EUREKA_URL=http://localhost:8761/eureka/

# Authentication & Security
JWT_SECRET=northstar-bank-super-secret-key-change-me-12345
JWT_EXPIRATION_MS=86400000

# Frontend API Endpoint
VITE_API_URL=http://localhost:8080
